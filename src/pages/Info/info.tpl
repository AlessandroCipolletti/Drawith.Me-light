<div class="drawith__info">

  <div class="tabs-wrapper drawith__info-tabs-wrapper">
    <div class="tabs-header">
      <div class="tab-header-item" data-tab-id="about-us">
        <span>{{labels.aboutUs}}</span>
      </div>
      <div class="tab-header-item" data-tab-id="terms-of-service">
        <span>{{labels.terms}}</span>
      </div>
      <div class="tab-header-item" data-tab-id="cookie-policy">
        <span>{{labels.cookiePolicy}}</span>
      </div>
      <div class="tab-header-item" data-tab-id="privacy-policy">
        <span>{{labels.privacy}}</span>
      </div>
    </div>
    <div class="tabs-content">
      <div class="tab-content scrollable drawith__aboutus" data-tab-id="about-us">
        <div class="drawith__aboutus-logo"></div>
        <div class="drawith__aboutus-draw"></div>
        <span class="drawith__aboutus-version">{{labels.version}}: {{version}}</span>
        <p class="drawith__aboutus-info">
          Drawith.me Srl<br>
          Rue de venise 12, Ixelles 1050, Bruxelles, Belgique<br>
          <a href="mailto:info@drawith.me">info@drawith.me</a><br>
          {{labels.createdBy}}<br>
          Alessandro Cipolletti<br>
          {{labels.and}}<br>
          Gaetano Saturno
        </p>
      </div>

    </div>
  </div>

</div>
